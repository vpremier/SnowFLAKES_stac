import matplotlib.pyplot as plt
import geopandas as gpd
import rasterio
from rasterio.sample import sample_gen
import pandas as pd
import numpy as np

# Function to extract raster values for each point in the shapefile
def extract_raster_values(shapefile_path, raster_path):
    # Read the shapefile
    gdf = gpd.read_file(shapefile_path)
    
    # Open the raster file
    with rasterio.open(raster_path) as src:
        # Extract raster values for each point
        coords = [(point.x, point.y) for point in gdf.geometry]
        values = list(sample_gen(src, coords))
        
        # Flatten the values if there are multiple bands
        if src.count > 1:
            values = [[value[i] for i in range(src.count)] for value in values]
        else:
            values = [value[0] for value in values]
    
    # Create a dataframe with the extracted values and class column
    df = pd.DataFrame(values, columns=[f'Band_{i}' for i in range(1, src.count + 1)])
    
    # Add the class column from the shapefile
    df['class'] = gdf['class'].values
    return df

# Function to compute the mean and standard deviation by class
def stats_by_class(df, class_column='class'):
    # Compute the mean and std for each class
    mean_df = df.groupby(class_column).mean().reset_index()
    std_df = df.groupby(class_column).std().reset_index()
    
    return mean_df, std_df

# Example usage

# Path of the shapefile with the endmenbers
#shapefile_path = '/mnt/CEPH_PROJECTS/ALPSNOW/Riccardo/ESA_Training/shapefiles/endmembers_msu.shp'
shapefile_folder_name = 'shapefiles_solution'
shapefile_path = os.path.join(current_dir, shapefile_folder_name, 'endmembers_msu.shp')

# Path of the stacked bands with extension .vrt
#raster_path = '/mnt/CEPH_PROJECTS/ALPSNOW/Riccardo/ESA_Training/S2B_MSIL1C_20201125T103349_N0209_R108_T32TLR_20201125T114106/S2B_MSIL1C_20201125T103349_N0209_R108_T32TLR_20201125T114106_10m_scf.vrt'
raster_path = os.path.join(current_dir, 'S2B_MSIL1C_20201125T103349_N0209_R108_T32TLR_20201125T114106', 'S2B_MSIL1C_20201125T103349_N0209_R108_T32TLR_20201125T114106_10m_scf.vrt')


bands_wavelengths = [0.490, 0.560, 0.665, 0.705, 0.740, 0.783, 0.842, 0.865, 1.610, 2.190]

# Extract the raster values and compute the mean and std by class
df = extract_raster_values(shapefile_path, raster_path)
mean_df, std_df = stats_by_class(df, class_column='class')

# Plotting reflectance curves with shaded buffer (std as the shaded area)
plt.figure(figsize=(10, 6))

# Plot each endmember reflectance curve with shaded error
for index, row in mean_df.iterrows():
    class_name = row['class']
    reflectance_means = row[1:].astype(float).values  # Convert to float

    # Get the corresponding std values for the same class
    std_row = std_df.loc[std_df['class'] == class_name]
    reflectance_stds = std_row.iloc[0, 1:].astype(float).values  # Convert to float

    # Ensure no NaN or None values
    reflectance_means = np.nan_to_num(reflectance_means)
    reflectance_stds = np.nan_to_num(reflectance_stds)

    # Plot the mean reflectance curve
    plt.plot(bands_wavelengths, reflectance_means, label=class_name, marker='o')

    # Fill the area between (mean - std) and (mean + std) with a transparent color
    plt.fill_between(bands_wavelengths, 
                     reflectance_means - reflectance_stds, 
                     reflectance_means + reflectance_stds, 
                     alpha=0.2)  # Set transparency for the filled area

# Set proportional x-axis (wavelengths)
plt.xscale('linear')

# Labeling
plt.title('Spectral Reflectance Curves with Standard Deviation')
plt.xlabel('Wavelength (µm)')
plt.ylabel('Reflectance')
plt.legend(title='Endmembers')
plt.grid(True)

# Show the plot
plt.tight_layout()
plt.show()






from rasterio.plot import reshape_as_image, reshape_as_raster
from scipy.optimize import lsq_linear
from joblib import Parallel, delayed
import numpy as np
import matplotlib.pyplot as plt

def sp_unmixing(endmembers_matrix, array_to_unmix):
    bounds = (0, 1)
    scf_array = np.zeros((len(array_to_unmix)))

    for curr_pix in range(np.shape(array_to_unmix)[0]):
        r = array_to_unmix[curr_pix, :].astype('double')

        abundances = lsq_linear(endmembers_matrix, r, bounds, lsq_solver=None, lsmr_tol=None, max_iter=None, verbose=0)['x']
        snow_abundance = abundances[1] + abundances[2]
        
        sum_of_unshaded_abundances = np.sum(abundances)
        scf = (snow_abundance / sum_of_unshaded_abundances) if sum_of_unshaded_abundances != 0 else 0
        scf_array[curr_pix] = scf

    return scf_array

Nprocesses = 8

with rasterio.open(raster_path) as src:
    raster_data = src.read()

img_reshaped = np.array(raster_data.reshape(src.count, -1)).T  # (num_pixels, num_bands)
endmembers_matrix = mean_df.drop(columns='class').values.T  # Prepare the endmembers matrix

# Split the image data into chunks for parallel processing
samplesBlocks = np.array_split(img_reshaped, Nprocesses, axis=0)

# Perform spectral unmixing in parallel
scf_blocks = Parallel(n_jobs=Nprocesses, verbose=10)(
    delayed(sp_unmixing)(endmembers_matrix, samplesBlocks[i]) for i in range(Nprocesses)
)

# Combine the results from the parallel blocks back into a single array
scf_array = np.concatenate(scf_blocks, axis=0)

# Reshape the scf_array to the original raster shape
scf_unmixing = scf_array.reshape(np.shape(raster_data[0])) * 100

# Calculate RMSE
rmse_unmixing = np.sqrt(mean_squared_error(reference_map[valid_mask], scf_unmixing[valid_mask]))

# Calculate MBE
mbe_unmixing = np.mean(scf_unmixing[valid_mask] - reference_map[valid_mask])

# Print RMSE and MBE values
print(f"RMSE: {rmse_unmixing:.2f}")
print(f"MBE: {mbe_unmixing:.2f}")

# Plotting the results
fig, ax = plt.subplots(1, 3, figsize=(20, 10))

# Plot the RGB false-color composite (assuming you have this variable from somewhere)
ax[0].imshow(rgb_false_color)  # Normalizing by 10000 for better visualization
ax[0].set_title('RGB False-Color Composite')
ax[0].axis('off')

# Plot the Snow Cover Fraction (SCF) map
scf_plot = ax[1].imshow(scf_unmixing, cmap=custom_cmap, vmin=0, vmax=100)
ax[1].set_title('Snow Cover Fraction (SCF) Map Linear Unmixing')
ax[1].axis('off')

# Add a colorbar to the SCF map
cbar = plt.colorbar(scf_plot, ax=ax[1], orientation='vertical')
cbar.set_label('SCF Value')

# Plot the reference Snow Cover Fraction (SCF) map
scf_plot = ax[2].imshow(reference_map, cmap=custom_cmap, vmin=0, vmax=100)
ax[2].set_title('Snow Cover Fraction (SCF) Map Reference')
ax[2].axis('off')

# Add a colorbar to the SCF map
cbar = plt.colorbar(scf_plot, ax=ax[2], orientation='vertical')
cbar.set_label('SCF Value')

# Display the plots
plt.tight_layout()
plt.show()






from sklearn import datasets
from sklearn.svm import SVC
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(30)

# Create linearly separable data
X, y = datasets.make_classification(n_features=2, n_redundant=0, n_informative=2, n_clusters_per_class=1, class_sep=1.5)
# Standardize the data
scaler = StandardScaler().fit(X)
X = scaler.transform(X)

# Train an SVM model with linear kernel
clf = SVC(kernel='linear', C=1)
clf.fit(X, y)

# Point to evaluate

point_to_evaluate = [0.5, -0.2]
point_to_evaluate = np.array(point_to_evaluate).reshape(-1, 1).T

df_point_to_evaluate = clf.decision_function(point_to_evaluate)

scf_point_to_evaluate = int(np.clip(50*df_point_to_evaluate + 50, 0, 100)[0])

print(f'The SCF of the evaluated point is: {scf_point_to_evaluate}%')

def plot_decision_boundary(clf, X, y, point_to_evaluate):
    h = 0.02
    x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1
    y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)

    # Plot decision boundary and margins
    plt.contourf(xx, yy, Z, alpha=0.5, cmap=plt.cm.coolwarm_r)

    # Plot training points
    plt.scatter(X[:, 0], X[:, 1], c=y, edgecolors='k', marker='o', cmap=plt.cm.coolwarm_r)

    # Get the coefficients and intercept of the linear decision boundary
    w = clf.coef_[0]
    b = clf.intercept_[0]
    
    # Decision boundary: w[0] * x + w[1] * y + b = 0
    # Hyperplanes: w[0] * x + w[1] * y + b = ±1 (for margins)
    
    # Plot the decision boundary (decision function = 0)
    slope = -w[0] / w[1]
    intercept = -b / w[1]
    x_vals = np.linspace(x_min, x_max, 100)
    plt.plot(x_vals, slope * x_vals + intercept, 'k', label='Decision boundary')

    # Plot margins (decision function = 1 and -1)
    margin = 1 / np.linalg.norm(w)
    plt.plot(x_vals, slope * x_vals + (intercept + margin), 'g--', label='Margin 100% scf')
    plt.plot(x_vals, slope * x_vals + (intercept - margin), 'r--', label='Margin 0% scf')

    # Highlight the support vectors
    plt.scatter(clf.support_vectors_[:, 0], clf.support_vectors_[:, 1], s=100, facecolors='none', edgecolors='yellow', label='Support Vectors')

    # Add the standardized point you want to evaluate
    plt.scatter(point_to_evaluate[:, 0], point_to_evaluate[:, 1], c='orange', edgecolors='black', s=100, label='Point to Evaluate')

    # Set axis limits manually to maintain consistent scaling and aspect ratio
    #plt.xlim([x_min, x_max])
    #plt.ylim([y_min, y_max])

    plt.xlim(X[:, 0].min(), X[:, 0].max())
    plt.ylim(X[:, 1].min(), X[:, 1].max())
    
    # Ensure the x and y axis have equal scaling (aspect ratio)
    plt.gca().set_aspect('equal', adjustable='box')

    plt.title(f"SVM with Linear Kernel (C={clf.C})")
    plt.legend()
    plt.show()

# Calling the function to plot the decision boundary, margins, and support vectors
plot_decision_boundary(clf, X, y, point_to_evaluate)





from sklearn import datasets
from sklearn.svm import SVC
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(30)

# Create linearly separable data
X, y = datasets.make_classification(n_features=2, n_redundant=0, n_informative=2, n_clusters_per_class=1, class_sep=1.5)
# Standardize the data
scaler = StandardScaler().fit(X)
X = scaler.transform(X)

# Train an SVM model with linear kernel
clf_linear = SVC(kernel='linear', C=10)
clf_linear.fit(X, y)

# Train an SVM model with rbf kernel
clf_rbf = SVC(kernel='rbf', C=1, gamma=0.01)
clf_rbf.fit(X, y)

# Point to evaluate
point_to_evaluate = [0.5, -0.2]
point_to_evaluate = np.array(point_to_evaluate).reshape(-1, 1).T

# Linear kernel decision function
df_point_to_evaluate_lin = clf_linear.decision_function(point_to_evaluate)
df_point_to_evaluate_lin = int(np.clip(50*df_point_to_evaluate_lin + 50, 0, 100)[0])

print(f'Linear kernel: the SCF of the evaluated point is: {df_point_to_evaluate_lin}%')

# RBF kernel decision function
df_point_to_evaluate_rbf = clf_rbf.decision_function(point_to_evaluate)
df_point_to_evaluate_rbf = int(np.clip(50*df_point_to_evaluate_rbf + 50, 0, 100)[0])

