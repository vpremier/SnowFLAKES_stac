def plot_decision_boundary(ax, clf, X, y, point_to_evaluate, title):
    h = 0.02
    x_min, x_max = X[:, 0].min() - 1, X[:, 0].max() + 1
    y_min, y_max = X[:, 1].min() - 1, X[:, 1].max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()])
    Z = Z.reshape(xx.shape)

    # Plot decision boundary and margins
    ax.contourf(xx, yy, Z, alpha=0.5, cmap=plt.cm.coolwarm_r)

    # Plot training points
    ax.scatter(X[:, 0], X[:, 1], c=y, edgecolors='k', marker='o', cmap=plt.cm.coolwarm_r)

    # For linear kernel, plot the decision boundary and margins
    if clf.kernel == 'linear':
        w = clf.coef_[0]
        b = clf.intercept_[0]
        slope = -w[0] / w[1]
        intercept = -b / w[1]
        x_vals = np.linspace(x_min, x_max, 100)
        ax.plot(x_vals, slope * x_vals + intercept, 'k', label='Decision boundary')

        margin = 1 / np.linalg.norm(w)
        ax.plot(x_vals, slope * x_vals + (intercept + margin), 'g--', label='Margin 100% scf')
        ax.plot(x_vals, slope * x_vals + (intercept - margin), 'r--', label='Margin 0% scf')

    # Highlight the support vectors
    ax.scatter(clf.support_vectors_[:, 0], clf.support_vectors_[:, 1], s=100, facecolors='none', edgecolors='yellow', label='Support Vectors')

    # Add the standardized point you want to evaluate
    ax.scatter(point_to_evaluate[:, 0], point_to_evaluate[:, 1], c='orange', edgecolors='black', s=100, label='Point to Evaluate')

    # Set axis limits manually to maintain consistent scaling and aspect ratio
    ax.set_xlim(X[:, 0].min(), X[:, 0].max())
    ax.set_ylim(X[:, 1].min(), X[:, 1].max())

    # Ensure the x and y axis have equal scaling (aspect ratio)
    ax.set_aspect('equal', adjustable='box')
    ax.set_title(title)
    ax.legend()

# Create subplots for side-by-side comparison
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# Plot the decision boundary for the linear kernel
plot_decision_boundary(axes[0], clf_linear, X, y, point_to_evaluate, "SVM with Linear Kernel (C=1)")

# Plot the decision boundary for the RBF kernel
plot_decision_boundary(axes[1], clf_rbf, X, y, point_to_evaluate, f"SVM with RBF Kernel (C={clf_linear.C}), gamma={clf_rbf.gamma})")

plt.show()



